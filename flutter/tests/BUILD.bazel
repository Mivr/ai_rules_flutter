# FF6 architecture invariants (Gate 13 section D): the provider analysis cases
# and the production-.bzl source scan, behind one command. The scan walks the
# live tree like the download guard above, so it needs no file list.
dart_test(
    name = "architecture_source_scan_test",
    size = "small",
    data = ["architecture_source_scan_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :architecture_source_scan_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "architecture_source_scan_test.dart",
    tags = [
        "external",
        "local",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)

