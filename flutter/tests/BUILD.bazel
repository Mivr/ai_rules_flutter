# The dependency-floor table is read by //flutter/tests:dependency_floors_test
# and by e2e/min_versions, which resolves the same declared floors.
exports_files(["dependency_floors.json"])

# The checked-in TinyKit fixtures the Apple framework-import tests and the iOS
# integration workspace consume. Both are tiny static frameworks: no download
# and no build step fetches or compiles them.
filegroup(
    name = "TinyKit.xcframework",
    srcs = glob(["fixtures/TinyKit.xcframework/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "TinyKit.framework",
    srcs = glob(["fixtures/TinyKit.framework/**"]),
    visibility = ["//visibility:public"],
)

# Parser shared by the root floor guard and e2e/min_versions, so both read
# MODULE.bazel and the table the same way. The buildifier config guard in
# ./buildifier_config reads the `buildifier_prebuilt` version through it too.
dart_library(
    name = "dependency_floors_lib",
    package_name = "dependency_floors",
    srcs = ["lib/dependency_floors_lib.dart"],
    visibility = ["//visibility:public"],
)

# Static guards: the download guard discovers every `.bzl` under flutter/
# and every MODULE.bazel at runtime from the workspace root (found through
# the test's own source file in `data`, hence no-sandbox), so there is no
# file list to maintain. The guards read files Bazel does not track as
# their inputs; the `external` tag keeps Bazel from replaying a cached pass
# after an untracked file changed, so each guard re-runs on every
# invocation.
dart_test(
    name = "download_digest_guard_test",
    size = "small",
    data = ["download_digest_guard_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :download_digest_guard_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "download_digest_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)

# Exec-toolchain guard: every `ctx.actions.run` / `run_shell` call under
# flutter/ declares `toolchain =`, so auto exec groups can match the action to
# the toolchain that supplies its executable. Same discovery mechanism as above.
dart_test(
    name = "exec_toolchain_guard_test",
    size = "small",
    data = ["exec_toolchain_guard_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :exec_toolchain_guard_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "exec_toolchain_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)

