load("@rules_dart//dart:defs.bzl", "dart_test")
load("//flutter/private:common.bzl", "HOST_COMPATIBLE")

# Guards the burn-down of `unnecessary_type_name_in_constructor`: the rule must
# stay evicted from the analysis baseline and no file may keep an empty map.
dart_test(
    name = "ctor_type_names_baseline_test",
    size = "small",
    srcs = ["ctor_type_names_baseline_test.dart"],
    data = ["//:analysis_baseline.json"],
    env = {"ANALYSIS_BASELINE_RLOCATION": "$(rlocationpath //:analysis_baseline.json)"},
    main = "ctor_type_names_baseline_test.dart",
    target_compatible_with = HOST_COMPATIBLE,
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
