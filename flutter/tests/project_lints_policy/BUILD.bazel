load("@rules_dart//dart:defs.bzl", "dart_test")
load("//flutter/private:common.bzl", "HOST_COMPATIBLE")

# Guards the wave-1 project lints: the root analysis_options.yaml enables the
# four rules and analysis_baseline.json stays sorted, positive and free of
# `no_stdout_in_worker` entries.
dart_test(
    name = "project_lints_policy_test",
    size = "small",
    srcs = ["project_lints_policy_test.dart"],
    data = [
        "//:analysis_baseline.json",
        "//:analysis_options.yaml",
    ],
    env = {
        "ANALYSIS_BASELINE_RLOCATION": "$(rlocationpath //:analysis_baseline.json)",
        "ANALYSIS_OPTIONS_RLOCATION": "$(rlocationpath //:analysis_options.yaml)",
    },
    main = "project_lints_policy_test.dart",
    target_compatible_with = HOST_COMPATIBLE,
    deps = [
        "@dev_tool_deps//:test",
        "@dev_tool_deps//:yaml",
        "@rules_dart//dart/runfiles",
    ],
)
