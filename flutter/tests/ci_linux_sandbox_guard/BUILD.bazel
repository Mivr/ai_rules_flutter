load("@rules_dart//dart:defs.bzl", "dart_test")

# Pure verifier unit tests over synthetic inputs; hermetic.
dart_test(
    name = "ci_linux_sandbox_guard_unit_test",
    size = "small",
    srcs = ["ci_linux_sandbox_verifier.dart"],
    main = "ci_linux_sandbox_guard_unit_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

# Runs the verifier over the live script and workflows in the checkout.
dart_test(
    name = "ci_linux_sandbox_guard_test",
    size = "medium",
    srcs = ["ci_linux_sandbox_verifier.dart"],
    data = ["ci_linux_sandbox_guard_test.dart"],
    env = {
        "GUARD_ROOT_ANCHOR": "$(rlocationpath :ci_linux_sandbox_guard_test.dart)",
