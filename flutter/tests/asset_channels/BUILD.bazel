"""Cross-channel asset key fixtures (COV-63).

Each bundle below pins one ordering of the channel claims: own `assets`
entries first, then compiled-shader, pub and (on applications, which are
the only targets that ship data assets) data claims in bundle order.
The `manual` tag keeps the intentionally-failing targets and the
applications out of `//...` builds; only the analysistest suite builds
them.
"""

load("//flutter:defs.bzl", "flutter_application", "flutter_asset_bundle", "flutter_library", "flutter_plugin")
load("//flutter:native_assets.bzl", "flutter_data_asset")
load(":asset_channels_test.bzl", "asset_channels_test_suite")

# Own-assets key of `:own_lib`, and the data destination of `:blob_data`.
flutter_library(
    name = "own_lib",
    package_name = "cov63",
    srcs = ["lib.dart"],
    assets = ["channel_data/own.txt"],
)

# Bare pub key `channel_data/own.txt`: `package_name` unset is the empty
# sentinel, so this claims the same key the collision bundle lists as its
# own asset, with a different file.
flutter_library(
    name = "pub_other",
    srcs = ["lib.dart"],
    pkg_assets = {
        ":channel_data/other.txt": "channel_data/own.txt",
    },
)

# Own key meets a different pub file at one key: must fail, naming the
# key, both files and both labels.
flutter_asset_bundle(
    name = "own_pub_collision",
    assets = ["channel_data/own.txt"],
    tags = ["manual"],
    deps = [":pub_other"],
)

# Data destination `packages/cov63/channel_data/own.txt`: the same key
# `:own_lib` carries in the assets channel, with a different file.
flutter_data_asset(
    name = "blob_data",
    asset_id = "package:cov63/channel_data/own.txt",
    file = "packages/blob/blob.bin",
)

# A data file lands in a bundle only through an application. The glue stands
# in for package `cov63`'s hook output the way the synthetic e2e does: it
# claims the app's package and carries the data declaration into the
# `FlutterInfo` dep graph for `flutter_application` to pick up. It shares
# the app's package name because it shares its Bazel package: two Dart
# packages cannot be rooted at one directory.
flutter_plugin(
    name = "blob_glue",
    package_name = "cov63",
    srcs = [],
    data_assets = [":blob_data"],
    platforms = [],
    tags = ["manual"],
)

# Assets-channel key meets a different data file at one key: must fail,
# naming the key, both files and both labels.
flutter_application(
    name = "own_data_collision_app",
    package_name = "cov63",
    srcs = ["lib.dart"],
    main = "lib.dart",
    tags = ["manual"],
    deps = [
        ":blob_glue",
        ":own_lib",
    ],
)

# The same file claimed as a bundle own asset and as a bare pub asset:
# legal, bundled once.
flutter_library(
    name = "pub_shared",
    srcs = ["lib.dart"],
    pkg_assets = {
        ":channel_data/shared.txt": "channel_data/shared.txt",
    },
)

# The same file claimed as a library asset and as a data asset: legal.
flutter_library(
    name = "file_lib",
    package_name = "cov63",
    srcs = ["lib.dart"],
    assets = ["channel_data/shared.txt"],
)

flutter_data_asset(
    name = "file_data",
    asset_id = "package:cov63/channel_data/shared.txt",
    file = "channel_data/shared.txt",
)

flutter_asset_bundle(
    name = "shared_channel_bundle",
    assets = ["channel_data/shared.txt"],
    deps = [
        ":file_lib",
        ":pub_shared",
    ],
)

# The same file claimed as a library asset and as a data asset: legal, so
# the application below analyses and lists the key once.
flutter_plugin(
    name = "file_glue",
    package_name = "cov63",
    srcs = [],
    data_assets = [":file_data"],
    platforms = [],
    tags = ["manual"],
)

flutter_application(
    name = "shared_data_app",
    package_name = "cov63",
    srcs = ["lib.dart"],
    main = "lib.dart",
    tags = ["manual"],
    deps = [
        ":file_glue",
        ":file_lib",
    ],
)

# One family reached along two paths: written once in the bundle config.
flutter_library(
    name = "font_lib",
    srcs = ["lib.dart"],
    font_files = {
        ":fonts/Diamond.ttf": "fonts/Diamond.ttf",
    },
    fonts_json = '[{"family":"Diamond","fonts":[{"asset":"fonts/Diamond.ttf"}]}]',
)

flutter_library(
    name = "mid_a",
    srcs = ["lib.dart"],
    deps = [":font_lib"],
)

flutter_library(
    name = "mid_b",
    srcs = ["lib.dart"],
    deps = [":font_lib"],
)

flutter_asset_bundle(
    name = "font_diamond_bundle",
    deps = [
        ":mid_a",
        ":mid_b",
    ],
)

# One family name carried with two different font lists: must fail,
# naming the family and both libraries.
flutter_library(
    name = "font_clash_a",
    srcs = ["lib.dart"],
    font_files = {
        ":fonts/ClashA.ttf": "fonts/ClashA.ttf",
    },
    fonts_json = '[{"family":"Diamond","fonts":[{"asset":"fonts/ClashA.ttf"}]}]',
)

flutter_library(
    name = "font_clash_b",
    srcs = ["lib.dart"],
    font_files = {
        ":fonts/ClashB.ttf": "fonts/ClashB.ttf",
    },
    fonts_json = '[{"family":"Diamond","fonts":[{"asset":"fonts/ClashB.ttf"}]}]',
)

flutter_asset_bundle(
    name = "font_clash_bundle",
    tags = ["manual"],
    deps = [
        ":font_clash_a",
        ":font_clash_b",
    ],
)

asset_channels_test_suite(name = "asset_channels_tests")
