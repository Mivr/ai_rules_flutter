"""Fan-in benchmark pool (COV-63): weighted base plus 300 thin deps.

The pool holds the weighted base library (`p` generated contributions,
half font families and half plain assets) and the fixed pool of thin
libraries the measured bundles take. The bundles live in the `narrow/`
and `wide/` subpackages so that touching one bundle's BUILD file
re-analyses only that bundle. Vary `p` here (`0` vs `6000`) and measure
each bundle with `build --nobuild` after touching only that bundle's
BUILD file: `wide - narrow` must not grow with `p`. Every target is
`manual`: the pool at `p = 6000` stays out of `//...` builds.
"""

load(":defs.bzl", "asset_fanin_pool")

package(
    default_visibility = ["//flutter/tests/asset_fanin:__subpackages__"],
)

asset_fanin_pool(
    name = "fanin",
    p = 6000,
)
