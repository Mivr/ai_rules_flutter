load("@rules_dart//dart:defs.bzl", "dart_test")

# Guards the Stage S0 test-hygiene fixes for the pod lint library, the pub_scc
# e2e sizes, the flaky guard size and the Starlark unit-test suites. It reads
# live BUILD files, so it is unsandboxed and tagged `external` to re-run on
# every invocation.
dart_test(
    name = "test_hygiene_pod_scc_guard_test",
    size = "medium",
    args = ["$(rlocationpath :test_hygiene_pod_scc_guard_test.dart)"],
    data = ["test_hygiene_pod_scc_guard_test.dart"],
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "test_hygiene_pod_scc_guard_test.dart",
    tags = [
        "external",
        "local",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
