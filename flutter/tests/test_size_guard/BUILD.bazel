load("@rules_dart//dart:defs.bzl", "dart_test")

# Test-budget guard: every test target declares a size, every Starlark suite
# goes through `small_unittest_suite`, and the Dart cases that once asserted
# nothing keep a concrete assertion. It reads the BUILD files of the e2e
# workspaces (separate modules the root `bazel test //...` never loads) and the
# Dart tests as text from the workspace root, resolved through the runfiles
# anchor. Reading undeclared files means Bazel cannot know when they change,
# so the target is `external` (re-run on every invocation) and `no-sandbox`
# (the anchor must resolve to the source tree, not a sandbox copy).
dart_test(
    name = "test_size_guard_test",
    size = "small",
    data = ["test_size_guard_test.dart"],
    env = {
        "GUARD_ROOT_ANCHOR": "$(rlocationpath :test_size_guard_test.dart)",
    },
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "test_size_guard_test.dart",
    tags = [
        "external",
        "local",
        "no-sandbox",
        "tree-reader",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)
