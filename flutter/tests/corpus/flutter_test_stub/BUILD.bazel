load("@rules_dart//dart:defs.bzl", "dart_library")

# Its own Bazel package so the stub has a package root distinct from the
# corpus' own Dart package, which `synthesize_app_package` requires.
dart_library(
    name = "flutter_test_dep",
    package_name = "flutter_test",
    srcs = ["lib/stub.dart"],
    visibility = ["//flutter/tests/corpus:__pkg__"],
)
