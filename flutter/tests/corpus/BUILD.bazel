# -- Corpus tooling -----------------------------------------------------------

# Static export guard: discovers the workspace from its own runfile, reads the
# ten public entry points and the corpus BUILD, and fails when a public export
# is neither instantiated nor listed in non_instantiable.txt. Same unsandboxed
# discovery shape as the guards in //flutter/tests.
dart_test(
    name = "exports_test",
    size = "small",
    srcs = ["golden_scope.dart"],
    data = [
        "BUILD.bazel",
        "actions.golden.json",
        "exports_test.dart",
        "golden_scope.dart",
        "golden_targets.txt",
        "non_instantiable.txt",
        "uncovered_golden.txt",
    ],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :exports_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "exports_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = ["@dev_tool_deps//:test"],
)

dart_test(
    name = "actions_golden_test",
    size = "small",
    srcs = ["actions_golden.dart"],
    data = glob(["testdata/**"]),
    main = "actions_golden_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

dart_test(
    name = "golden_scope_test",
    size = "small",
    srcs = ["golden_scope.dart"],
    main = "golden_scope_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

dart_binary(
    name = "actions_golden",
    data = ["actions.golden.json"],
    main = "actions_golden.dart",
)

# The corpus targets live in this package, not a subpackage, so the contract's
# `//flutter/tests/corpus:...` pattern is a literal target name rather than a
# recursive wildcard. This suite makes that exact invocation run both tests;
# `//flutter/tests/corpus/...` also finds them individually.
test_suite(
    name = "...",
    tests = [
        ":actions_golden_test",
        ":exports_test",
        ":golden_scope_test",
    ],
)
