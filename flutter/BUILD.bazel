# Flutter's profile mode: AOT like release, with the Dart VM service kept so
# DevTools can attach. Applies with `-c opt` only:
#
#   bazel build -c opt --@rules_flutter//flutter:profile //app
#
# `flutter_bazel run --profile` sets both.
bool_flag(
    name = "profile",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Release mode: `-c opt` without the profile flag. Used by select() in macros.
config_setting(
    name = "release",
    flag_values = {":profile": "false"},
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# Whether `flutter_android_app` builds rules_android's Go host tools in
# rules_go pure mode (no C++ toolchain, so the hermetic LLVM runtimes are never
# compiled from source). Default on; opt out with
# `--@rules_flutter//flutter:android_pure_go=false`, for example when the app's
# own subtree needs cgo. Scoped to the app: nothing outside a Flutter Android
# app's build sees it.
bool_flag(
    name = "android_pure_go",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# `flutter_android_app` finishes its APK by injecting the Flutter payload after
# resource linking and re-running the stock zipalign/sign steps. The signature
# schemes follow `@rules_android//flags:apk_signing_method`, read here so the
# overlay signs exactly like the android_binary would have.
config_setting(
    name = "apk_signing_v1",
    flag_values = {"@rules_android//flags:apk_signing_method": "v1"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apk_signing_v2",
    flag_values = {"@rules_android//flags:apk_signing_method": "v2"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apk_signing_v4",
    flag_values = {"@rules_android//flags:apk_signing_method": "v4"},
    visibility = ["//visibility:public"],
)

# Release keystore for `flutter_android_app` (`flutter_android_apk_overlay`).
# A target that sets the `keystore` attribute always signs with it; a target
# that sets none takes the keystore from these flags, so CI can inject a
# secret without editing BUILD files:
#
#   bazel build //app --@rules_flutter//flutter:android_release_keystore=//secret:upload
#     --@rules_flutter//flutter:android_release_keystore_password_file=//secret:store_pass
#     --@rules_flutter//flutter:android_release_key_alias=upload
#
# A flag counts as set as soon as it names any target but its default below:
# that target must hold exactly one file, or analysis fails naming the flag,
# the target and the file count. Never point a flag at an `allow_empty` glob.
#
# With neither the attribute nor the flag set, the overlay signs with the
# debug keystore exactly as before.
filegroup(
    name = "_android_release_keystore_none",
    srcs = [],
)

filegroup(
    name = "_android_release_keystore_password_file_none",
    srcs = [],
)

label_flag(
    name = "android_release_keystore",
    build_setting_default = ":_android_release_keystore_none",
    visibility = ["//visibility:public"],
)

label_flag(
    name = "android_release_keystore_password_file",
    build_setting_default = ":_android_release_keystore_password_file_none",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "android_release_key_alias",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# Extra Dart environment defines folded into every Dart compile after any
# target-level `defines`. Repeatable:
#   bazel build //app --@rules_flutter//flutter:extra_dart_defines=FOO=bar
# `flutter_bazel run --dart-define FOO=bar` forwards here.
dart_defines_flag(
    name = "extra_dart_defines",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

# Opt-in incremental Flutter kernel compiles: when true, non-AOT
# whole-program (`target == "flutter"`) `FlutterKernelCompile` actions run
# through a persistent `frontend_server`
# worker (`//flutter/private/tools:incr_fkc_worker`) instead of a batch
# compile behind `kernel_filter`:
#
#   bazel build --@rules_flutter//flutter:incremental_kernel //app
#
# Scope: every non-AOT whole-program `target == "flutter"` compile in any
# compilation mode, the default included — never AOT, web (`dartdevc`),
# `from_dill`, `import_dill` or `recorded_uses` compiles. Off by default; a
# build with the flag off runs byte-identical actions to a build without it.
# One warm server holds about 1.75 GiB; bound worker processes with
# `--worker_max_instances=FlutterKernelCompile=N` (each worker keeps at most
# one warm server by default).
bool_flag(
    name = "incremental_kernel",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Development only: lets the incremental kernel worker keep `frontend_server`'s
# incremental serialization, so a warm edit does not rewrite the full dill from
# scratch. The resulting dill is NOT byte-identical to a one-shot compile. Do
# not use it in CI or remote-cache configurations: the compiles that use it
# carry `no-remote-cache` and `no-remote-exec`. Only has an effect together
# with `//flutter:incremental_kernel`, on the compiles that flag routes
# through the worker. Off by default; with it off every action is unchanged.
bool_flag(
    name = "dev_incremental_serialization",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Apps that use Material widgets list this in their flutter_application(
# deps = [...]) to bundle MaterialIcons-Regular.otf into flutter_assets/.
# Backed by the active flutter toolchain — the file ships with every
# flutter_engine_artifacts repo, but the file label is platform-specific,
# so a small custom rule resolves it via ctx.toolchains[...] instead of
# requiring callers to select() on the host platform.
flutter_material_icons(
    name = "material_icons",
    visibility = ["//visibility:public"],
)

# `dart pub`, run from the pinned toolchain against the current workspace, so
# that the SDK which resolves pubspec.lock is the SDK which compiles it:
#
#   bazel run @rules_flutter//flutter:pub -- get
#
# Fetches @flutter_dev_root on first use; no normal build depends on it.
flutter_pub(
    name = "pub",
    visibility = ["//visibility:public"],
)

