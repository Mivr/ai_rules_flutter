"""Repository rules for the iOS Flutter engine artifacts.

`@flutter_ios_engine` is a thin hub: a BUILD file of aliases to two private
per-mode repositories, one holding the release (AOT, device) engine and one the
debug (JIT, simulator) engine. Bazel loads an alias's target only when a
target selects it, so a debug-only build (`-c dbg`) never fetches the release
archive and a default or `-c opt` build never fetches the debug archive.

Consumers keep referencing the stable `@flutter_ios_engine` name once in
`use_repo`; the two mode repositories are visible to the hub by apparent name
because the module extension creates all three, so they need no `use_repo`
entry. The macOS engine repo works the same way (one name, two modes).

This is lazy: nothing is fetched until an iOS build target is used.
"""

load("//flutter/private:repo_metadata.bzl", "download_mode_metadata")
load(":artifact_urls.bzl", "engine_artifact_url", "ios_engine_artifact_path", "require_sha256")
load(":download.bzl", "pinned_download_and_extract")
load(":local_sdk.bzl", "engine_cache_dir", "link_local_dir", "link_local_file", "resolve_local_sdk_root")

_MODES = ["release", "debug"]

_MODE_BUILD_TEMPLATE = """# Generated by flutter_ios_engine_repo.bzl ({mode} iOS engine)

filegroup(
    name = "Flutter_xcframework",
    srcs = glob(["Flutter.xcframework/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

_HUB_BUILD_TEMPLATE = """# Generated by flutter_ios_engine_repo.bzl

# Release engine (AOT) — device builds (-c opt / default).
alias(
    name = "Flutter_xcframework",
    actual = "@{release}//:Flutter_xcframework",
    visibility = ["//visibility:public"],
)

# The iOS gen_snapshot the release archive carries (macos->ios cross-compile).
alias(
    name = "gen_snapshot_arm64",
    actual = "@{release}//:gen_snapshot_arm64",
    visibility = ["//visibility:public"],
)

# Debug engine (JIT) — simulator builds (-c dbg).
alias(
    name = "Flutter_xcframework_debug",
    actual = "@{debug}//:Flutter_xcframework",
    visibility = ["//visibility:public"],
)
"""

def ios_engine_hub_build(release_repo, debug_repo):
    """BUILD content of the `@flutter_ios_engine` hub.

    Args:
        release_repo: Apparent name of the release engine repository.
        debug_repo: Apparent name of the debug engine repository.

    Returns:
        The hub BUILD file text: aliases only, no archive of its own.
    """
    return _HUB_BUILD_TEMPLATE.format(release = release_repo, debug = debug_repo)

def _link_local_mode(repository_ctx, mode):
    sdk_root = resolve_local_sdk_root(repository_ctx, repository_ctx.attr.local_path)
    cache_dir = engine_cache_dir(ios_engine_artifact_path(mode))
    link_local_dir(
        repository_ctx,
        sdk_root,
        "bin/cache/artifacts/engine/" + cache_dir + "/Flutter.xcframework",
        "Flutter.xcframework",
        "the {} iOS engine".format(mode),
    )
    if mode == "release":
        link_local_file(
            repository_ctx,
            sdk_root,
            "bin/cache/artifacts/engine/" + cache_dir + "/gen_snapshot_arm64",
            "gen_snapshot_arm64",
            "the release iOS gen_snapshot",
        )

def flutter_ios_engine_mode_repo_impl(repository_ctx):
    """Fetches one iOS engine mode: only that mode's archive is requested.

    The release archive also carries the iOS gen_snapshot used by the
    macos->ios cross-compile toolchain.

    Args:
        repository_ctx: The repository rule context.

    Returns:
        The repository metadata (reproducible in download mode).
    """
    mode = repository_ctx.attr.mode
    if mode not in _MODES:
        fail("flutter_ios_engine_mode_repo: mode must be one of {}, got '{}'".format(_MODES, mode))
    if repository_ctx.attr.local_path:
        _link_local_mode(repository_ctx, mode)
    else:
        url = engine_artifact_url(
            repository_ctx.attr.engine_revision,
            ios_engine_artifact_path(mode),
            repository_ctx.attr.engine_base_url,
        )
        pinned_download_and_extract(
            repository_ctx,
            url = url,
            sha256 = require_sha256(repository_ctx.attr.sha256, url),
        )
    repository_ctx.file("BUILD.bazel", _MODE_BUILD_TEMPLATE.format(mode = mode))
    return download_mode_metadata(repository_ctx)

def _flutter_ios_engine_repo_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", ios_engine_hub_build(
        repository_ctx.attr.release_repo,
        repository_ctx.attr.debug_repo,
    ))
    return repository_ctx.repo_metadata(reproducible = True)

flutter_ios_engine_mode_repo = repository_rule(
    flutter_ios_engine_mode_repo_impl,
    doc = "Downloads one iOS Flutter engine mode (release or debug) Flutter.xcframework.",
    attrs = {
        "mode": attr.string(
            doc = "Engine mode: `release` (device, AOT) or `debug` (simulator, JIT).",
            mandatory = True,
        ),
        "engine_revision": attr.string(
            doc = "The engine commit hash the artifacts are published under. " +
                  "Empty means a local SDK (with `local_path`).",
            default = "",
        ),
        "engine_base_url": attr.string(
            doc = "Optional replacement origin for the engine revision " +
                  "directory (an enterprise build). Empty means the default GCS base.",
            default = "",
        ),
        "local_path": attr.string(
            doc = "Optional path to a pre-extracted Flutter SDK " +
                  "(bin/cache layout) to source the artifact from instead " +
                  "of the network. Mutually exclusive with downloading.",
            default = "",
        ),
        "sha256": attr.string(
            doc = "Expected SHA-256 of this mode's archive. Unused with `local_path`.",
            default = "",
        ),
    },
)

flutter_ios_engine_repo = repository_rule(
    _flutter_ios_engine_repo_impl,
    doc = "The `@flutter_ios_engine` hub: aliases to the per-mode engine repositories.",
    attrs = {
        "release_repo": attr.string(doc = "Apparent name of the release engine repository.", mandatory = True),
        "debug_repo": attr.string(doc = "Apparent name of the debug engine repository.", mandatory = True),
    },
)

def flutter_ios_engine_repos(
        name,
        engine_revision,
        engine_base_url = "",
        release_sha256 = "",
        debug_sha256 = "",
        local_path = "",
        mode_rule = flutter_ios_engine_mode_repo,
        hub_rule = flutter_ios_engine_repo):
    """Declares the `@<name>` hub and its two private per-mode repositories.

    Args:
        name: The hub repository name (`flutter_ios_engine`).
        engine_revision: Engine commit hash; empty with `local_path`.
        engine_base_url: Optional replacement origin for the engine directory.
        release_sha256: SHA-256 of the release archive.
        debug_sha256: SHA-256 of the debug archive.
        local_path: Optional local SDK root to link instead of downloading.
        mode_rule: The per-mode repository rule; replaceable for tests.
        hub_rule: The hub repository rule; replaceable for tests.
    """
    mode_rule(
        name = name + "_release",
        mode = "release",
        engine_revision = engine_revision,
        engine_base_url = engine_base_url,
        sha256 = release_sha256,
        local_path = local_path,
    )
    mode_rule(
        name = name + "_debug",
        mode = "debug",
        engine_revision = engine_revision,
        engine_base_url = engine_base_url,
        sha256 = debug_sha256,
        local_path = local_path,
    )
    hub_rule(
        name = name,
        release_repo = name + "_release",
        debug_repo = name + "_debug",
    )
