"""Implementations and attributes of the engine-adjacent SDK repository rules.

The product patched SDK, the Material fonts, the font-subset tools and the
macOS host-tools release each fetch lazily, or link out of a local SDK.
"""

load("//flutter/private:artifact_urls.bzl", "engine_artifact_url", "host_artifacts_path", "require_sha256")
load("//flutter/private:download.bzl", "pinned_download_and_extract")
load("//flutter/private:local_sdk.bzl", "host_engine_cache_dir", "link_local_dir", "link_local_file", "resolve_local_sdk_root")
load("//flutter/private:repo_metadata.bzl", "download_mode_metadata")

def flutter_patched_sdk_product_repo_impl(repository_ctx):
    """Fetches or links the product patched SDK.

    Args:
        repository_ctx: The repository context.

    Returns:
        Repository reproducibility metadata.
    """
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        link_local_dir(
            repository_ctx,
            sdk,
            "bin/cache/artifacts/engine/common/flutter_patched_sdk_product",
            "patched-sdk-product/flutter_patched_sdk_product",
            "patched SDK (product)",
        )
        _write_patched_sdk_product_build(repository_ctx)
        return download_mode_metadata(repository_ctx)
    url = engine_artifact_url(
        repository_ctx.attr.engine_revision,
        "flutter_patched_sdk_product.zip",
        getattr(repository_ctx.attr, "engine_base_url", ""),
    )
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "patched-sdk-product",
    )
    _write_patched_sdk_product_build(repository_ctx)
    return download_mode_metadata(repository_ctx)

def _write_patched_sdk_product_build(repository_ctx):
    """Writes BUILD.bazel for the product patched SDK repository."""
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
filegroup(
    name = "patched_sdk_product",
    srcs = glob(["patched-sdk-product/flutter_patched_sdk_product/**"]),
    visibility = ["//visibility:public"],
)

exports_files(glob(["**"]), visibility = ["//visibility:public"])
""")

FLUTTER_PATCHED_SDK_PRODUCT_REPO_ATTRS = {
    "engine_revision": attr.string(
        doc = "The engine commit hash. Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "sha256": attr.string(
        doc = "Expected SHA-256 of the product patched SDK archive. " +
              "Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "local_path": attr.string(
        doc = "Optional path to a pre-extracted Flutter SDK " +
              "(bin/cache layout) to source the product patched SDK from instead " +
              "of the network. Mutually exclusive with downloading.",
        default = "",
    ),
    "engine_base_url": attr.string(
        doc = "Optional replacement origin for the engine revision " +
              "directory used to download the product patched SDK (an enterprise build). " +
              "Empty means the default GCS base.",
        default = "",
    ),
}

def flutter_material_fonts_repo_impl(repository_ctx):
    """Fetches or links the Material design fonts.

    Args:
        repository_ctx: The repository context.

    Returns:
        Repository reproducibility metadata.
    """
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        link_local_dir(
            repository_ctx,
            sdk,
            "bin/cache/artifacts/material_fonts",
            "material-fonts",
            "material design fonts",
        )
        _write_material_fonts_build(repository_ctx)
        return download_mode_metadata(repository_ctx)
    fonts_path = repository_ctx.attr.material_fonts_url
    if fonts_path.startswith("https://"):
        url = fonts_path
    else:
        url = "https://storage.googleapis.com/" + fonts_path
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "material-fonts",
    )
    _write_material_fonts_build(repository_ctx)
    return download_mode_metadata(repository_ctx)

def _write_material_fonts_build(repository_ctx):
    """Writes BUILD.bazel for the Material design fonts repository."""
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
load("@rules_flutter//flutter:toolchain.bzl", "flutter_material_icons_toolchain")

exports_files(glob(["**"]), visibility = ["//visibility:public"])

flutter_material_icons_toolchain(
    name = "material_icons_toolchain",
    material_icons_font = "material-fonts/MaterialIcons-Regular.otf",
    visibility = ["//visibility:public"],
)
""")

FLUTTER_MATERIAL_FONTS_REPO_ATTRS = {
    "material_fonts_url": attr.string(
        doc = "GCS path of the fonts archive (a full https:// URL is " +
              "used as-is). Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "sha256": attr.string(
        doc = "Expected SHA-256 of the Material icon fonts archive. " +
              "Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "local_path": attr.string(
        doc = "Optional path to a pre-extracted Flutter SDK " +
              "(bin/cache layout) to source the Material icon fonts from instead " +
              "of the network. Mutually exclusive with downloading.",
        default = "",
    ),
}

def flutter_font_subset_repo_impl(repository_ctx):
    """Fetches or links the font-subset tools.

    Args:
        repository_ctx: The repository context.

    Returns:
        Repository reproducibility metadata.
    """
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))

        # Per host OS family, not per Bazel platform: macOS is always
        # `darwin-x64` (see `host_engine_cache_dir`).
        host_dir = "bin/cache/artifacts/engine/" + host_engine_cache_dir(repository_ctx.attr.platform)
        link_local_file(
            repository_ctx,
            sdk,
            host_dir + "/const_finder.dart.snapshot",
            "font-subset-tools/const_finder.dart.snapshot",
            "font-subset const_finder",
        )
        binary = "font-subset.exe" if repository_ctx.attr.platform.startswith("windows") else "font-subset"
        link_local_file(
            repository_ctx,
            sdk,
            host_dir + "/" + binary,
            "font-subset-tools/" + binary,
            "font-subset binary",
        )
        _write_font_subset_build(repository_ctx)
        return download_mode_metadata(repository_ctx)
    font_subset_path = "{platform}/font-subset.zip".format(platform = repository_ctx.attr.platform)
    url = engine_artifact_url(
        repository_ctx.attr.engine_revision,
        font_subset_path,
        getattr(repository_ctx.attr, "engine_base_url", ""),
    )
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "font-subset-tools",
    )
    _write_font_subset_build(repository_ctx)
    return download_mode_metadata(repository_ctx)

def _write_font_subset_build(repository_ctx):
    """Writes BUILD.bazel for the font-subset tools repository."""
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
exports_files(glob(["**"]), visibility = ["//visibility:public"])
""")

FLUTTER_FONT_SUBSET_REPO_ATTRS = {
    "engine_revision": attr.string(
        doc = "The engine commit hash. Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "platform": attr.string(
        doc = "The host platform the tools run on (e.g. `darwin-arm64`). " +
              "Selects the engine artifact path and the local SDK cache directory.",
        mandatory = True,
    ),
    "sha256": attr.string(
        doc = "Expected SHA-256 of the font-subset tools archive. " +
              "Empty means a local SDK (with `local_path`).",
        default = "",
    ),
    "engine_base_url": attr.string(
        doc = "Optional replacement origin for the engine revision " +
              "directory used to download the font-subset tools (an enterprise build). " +
              "Empty means the default GCS base.",
        default = "",
    ),
    "local_path": attr.string(
        doc = "Optional path to a pre-extracted Flutter SDK " +
              "(bin/cache layout) to source the font-subset tools from instead " +
              "of the network. Mutually exclusive with downloading.",
        default = "",
    ),
}

def flutter_host_tools_release_repo_impl(repository_ctx):
    """Fetches or links the release host tools.

    Args:
        repository_ctx: The repository context.

    Returns:
        Repository reproducibility metadata.
    """
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        link_local_dir(
            repository_ctx,
            sdk,
            "bin/cache/artifacts/engine/" + host_engine_cache_dir(repository_ctx.attr.platform) + "-release",
            "host-tools-release",
            "release host tools (product-mode gen_snapshot)",
        )
        _write_host_tools_release_build(repository_ctx)
        return download_mode_metadata(repository_ctx)
    release_tools_path = host_artifacts_path(repository_ctx.attr.platform, mode = "release")
    url = engine_artifact_url(
        repository_ctx.attr.engine_revision,
        release_tools_path,
        getattr(repository_ctx.attr, "engine_base_url", ""),
    )
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "host-tools-release",
    )
    _write_host_tools_release_build(repository_ctx)
    return download_mode_metadata(repository_ctx)

def _write_host_tools_release_build(repository_ctx):
    """Writes BUILD.bazel for the release host tools repository."""
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
exports_files(glob(["**"]), visibility = ["//visibility:public"])
""")

