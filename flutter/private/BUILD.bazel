# The arm64 simulator platform add-to-app xcframeworks build their simulator
# slice from. The public `//flutter/platforms` set predates Apple silicon
# simulators and names only `ios_x64`; keeping this one private avoids growing
# the public platform surface for a rule that fuses the two into one slice.
platform(
    name = "ios_sim_arm64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:aarch64",
        "@apple_support//constraints:simulator",
    ],
    visibility = ["//visibility:public"],
)

# Compilation mode config_settings for select() in macros.
# compilation_mode is preserved across platform transitions (e.g. iOS).
config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apk_signing_v1_dbg",
    flag_values = {"@rules_android//flags:apk_signing_method": "v1"},
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apk_signing_v2_dbg",
    flag_values = {"@rules_android//flags:apk_signing_method": "v2"},
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apk_signing_v4_dbg",
    flag_values = {"@rules_android//flags:apk_signing_method": "v4"},
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# Profile mode: `-c opt` with `--@rules_flutter//flutter:profile`. Selects the
# profile engine and gen_snapshot. The flag under any other `-c` matches
# neither this nor `//flutter:release`; `flutter_application` refuses it.
config_setting(
    name = "profile",
    flag_values = {"//flutter:profile": "true"},
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

