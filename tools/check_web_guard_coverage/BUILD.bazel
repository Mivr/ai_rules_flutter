load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# Fails when a web-guard hostile fixture is not built by a CI step that
# requires the guard refusal: `bazel run //tools/check_web_guard_coverage`
# from the repo root. CI runs it in the unit-tests job.
dart_binary(
    name = "check_web_guard_coverage",
    srcs = ["coverage.dart"],
    main = "check_web_guard_coverage.dart",
)

dart_test(
    name = "coverage_test",
    size = "small",
    srcs = ["coverage.dart"],
    main = "test/coverage_test.dart",
    deps = ["@dev_tool_deps//:test"],
)
