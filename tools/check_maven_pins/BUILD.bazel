load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# Fails when a maven.install in an e2e workspace has no checked-in, valid,
# sha256-pinned lock file covering its declared artifacts:
# `bazel run //tools/check_maven_pins` from the repo root.
dart_binary(
    name = "check_maven_pins",
    srcs = [
        "lock_check.dart",
        "module_parse.dart",
        "pins.dart",
    ],
    main = "check_maven_pins.dart",
)

dart_test(
    name = "pins_test",
    size = "small",
    srcs = [
        "lock_check.dart",
        "module_parse.dart",
        "pins.dart",
    ],
    main = "test/pins_test.dart",
    deps = ["@dev_tool_deps//:test"],
)
