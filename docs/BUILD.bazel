# //flutter:android.bzl has no starlark_doc_extract target: rules_android 0.8.0's
# android/BUILD declares no targets and rules_kotlin 2.4.20's release
# kotlin/BUILD.bazel leaves android.bzl out of every target, so no bzl_library
# can cover @rules_android//android:rules.bzl or
# @rules_kotlin//kotlin:android.bzl and starlark_doc_extract refuses the
# closure.

starlark_doc_extract(
    name = "defs.doc_extract",
    src = "//flutter:defs.bzl",
    deps = [
        "//flutter:defs",
    ],
)

starlark_doc_extract(
    name = "dev_files.doc_extract",
    src = "//flutter:dev_files.bzl",
    deps = [
        "//flutter:dev_files",
    ],
)

starlark_doc_extract(
    name = "extensions.doc_extract",
    src = "//flutter:extensions.bzl",
    deps = [
        "//flutter:extensions",
    ],
)

starlark_doc_extract(
    name = "ios.doc_extract",
    src = "//flutter:ios.bzl",
    deps = [
        "//flutter:ios",
    ],
)

starlark_doc_extract(
    name = "linux.doc_extract",
    src = "//flutter:linux.bzl",
    deps = [
        "//flutter:linux",
    ],
)

starlark_doc_extract(
    name = "macos.doc_extract",
    src = "//flutter:macos.bzl",
    deps = [
        "//flutter:macos",
    ],
)

starlark_doc_extract(
    name = "native_assets.doc_extract",
    src = "//flutter:native_assets.bzl",
    deps = [
        "//flutter:native_assets",
    ],
)

starlark_doc_extract(
    name = "native_hot_patch.doc_extract",
    src = "//flutter:native_hot_patch.bzl",
    deps = [
        "//flutter:native_hot_patch",
    ],
)

starlark_doc_extract(
    name = "providers.doc_extract",
    src = "//flutter:providers.bzl",
    deps = [
        "//flutter:providers",
    ],
)

starlark_doc_extract(
    name = "repositories.doc_extract",
    src = "//flutter:repositories.bzl",
    deps = [
        "//flutter:repositories",
    ],
)

starlark_doc_extract(
    name = "toolchain.doc_extract",
    src = "//flutter:toolchain.bzl",
    deps = [
        "//flutter:toolchain",
    ],
)

starlark_doc_extract(
    name = "utils.doc_extract",
    src = "//flutter:utils.bzl",
    deps = [
        "//flutter:utils",
    ],
)

starlark_doc_extract(
    name = "web.doc_extract",
    src = "//flutter:web.bzl",
    deps = [
        "//flutter:web",
    ],
)

starlark_doc_extract(
    name = "windows.doc_extract",
    src = "//flutter:windows.bzl",
    deps = [
        "//flutter:windows",
    ],
)

_DOC_EXTRACT_TARGETS = sorted([
    ":" + r["name"]
    for r in existing_rules().values()
    if r["kind"] == "starlark_doc_extract"
])

_ = len(_DOC_EXTRACT_TARGETS) == 14 or fail(
    "Expected 14 starlark_doc_extract targets in //docs, got %d" % len(
        _DOC_EXTRACT_TARGETS,
    ),
)

filegroup(
    name = "all_doc_extracts",
    srcs = [
        ":defs.doc_extract",
        ":dev_files.doc_extract",
        ":extensions.doc_extract",
        ":ios.doc_extract",
        ":linux.doc_extract",
        ":macos.doc_extract",
        ":native_assets.doc_extract",
        ":native_hot_patch.doc_extract",
        ":providers.doc_extract",
        ":repositories.doc_extract",
        ":toolchain.doc_extract",
        ":utils.doc_extract",
        ":web.doc_extract",
        ":windows.doc_extract",
    ],
    visibility = ["//visibility:public"],
)
