_DOC_EXTRACT_TARGETS = sorted([
    ":" + r["name"]
    for r in existing_rules().values()
    if r["kind"] == "starlark_doc_extract"
])

_ = len(_DOC_EXTRACT_TARGETS) == 15 or fail(
    "Expected 15 starlark_doc_extract targets in //docs, got %d" % len(
        _DOC_EXTRACT_TARGETS,
    ),
)

filegroup(
    name = "all_doc_extracts",
    srcs = _DOC_EXTRACT_TARGETS,
    visibility = ["//visibility:public"],
)
