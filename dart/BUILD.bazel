load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":flutter_sdk_binary.bzl", "flutter_sdk_binary")

# Run the Flutter-bundled Dart SDK binary:
#   bazel run @rules_flutter//dart -- --version
#   bazel run @rules_flutter//dart -- analyze lib/
flutter_sdk_binary(
    name = "dart",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "flutter_sdk_binary",
    srcs = ["flutter_sdk_binary.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//flutter:providers",
        "//flutter/private:run_home",
    ],
)
