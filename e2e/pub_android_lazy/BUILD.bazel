load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# A Dart-only consumer. Reaching this target fetches the plugin's spoke but
# must never fetch or analyse its Android repository; the plugin's Gradle
# build names an untranslatable coordinate on purpose (see MODULE.bazel).
dart_binary(
    name = "app",
    main = "lib/main.dart",
    deps = ["@deps//:lazy_plugin"],
)

# Hermetic regression test for `check_android_fail_closed.sh`: stub `bazel`
# executables prove the script fails closed on an unrelated aggregator failure
# and never substitutes a direct fetch of the plugin's Android repository.
dart_test(
    name = "check_android_fail_closed_test",
    size = "small",
    data = [
        "check_android_fail_closed.sh",
        "lazy_plugin/android/build.gradle",
    ],
    env = {
        "CHECK_SCRIPT": "$(rlocationpath check_android_fail_closed.sh)",
        "GRADLE_FILE": "$(rlocationpath lazy_plugin/android/build.gradle)",
    },
    main = "test/check_android_fail_closed_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
