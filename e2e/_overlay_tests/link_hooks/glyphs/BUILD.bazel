load("@rules_dart//dart:defs.bzl", "dart_library")

# A package with a link hook: `hook/link.dart` reads the recorded uses of
# `Glyph` and emits `package:glyphs/glyphs/index.json`, and fails the build on
# a `Glyph` constructed at run time.
dart_library(
    name = "glyphs",
    srcs = glob(["lib/**/*.dart"]),
    link_hook = "hook/link.dart",
    visibility = ["//visibility:public"],
    deps = [
        "@deps//:data_assets",
        "@deps//:hooks",
        "@deps//:meta",
        "@deps//:record_use",
    ],
)
