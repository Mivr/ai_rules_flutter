"""Podfile.lock red path: tab-indented lock must fail hub registration."""

module(name = "rules_flutter_podfile_lock_red")

bazel_dep(name = "ai_rules_flutter", version = "0.0.0", repo_name = "rules_flutter")
bazel_dep(name = "ai_rules_dart", version = "0.24.0", repo_name = "rules_dart")

local_path_override(
    module_name = "ai_rules_flutter",
    path = "../..",
)

git_override(
    module_name = "ai_rules_dart",
    commit = "db7ec60d2515e0f1dc0eeb6632e0f88b27abd21e",
    remote = "https://github.com/Mivr/ai_rules_dart.git",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.7")
flutter.pub(
    name = "red_deps",
    lock = "//:pubspec.lock",
    ios_podfile_lock = "//:Podfile.lock",
)
use_repo(flutter, "red_deps")
