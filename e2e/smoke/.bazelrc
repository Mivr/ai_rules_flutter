try-import %workspace%/.bazelrc.user

# `dart analyze` and the `dart format` check run as an aspect over every Dart
# target a `bazel test` names. The config line is `test`-scoped too: a `common`
# flag also applies to `bazel fetch`, where it makes `@local_linux-x64` depend on
# the real Flutter SDK download and breaks the offline lazy-fetch CI proof.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
test --@rules_dart//dart:analysis_config=//:analysis_config

# `fetch` inherits every `test` option, so the aspect above would make
# `bazel fetch @local_linux-x64//:dart_sdk_files` analyze that target, which
# needs the real Flutter SDK download. Fetching only loads the packages, so
# skipping analysis keeps the offline lazy-fetch CI proof working.
fetch --noanalyze
