load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_library")
load(":consumer_compile.bzl", "consumer_caller")

# Verify that the Flutter toolchain resolves by building the toolchains repo.
# This test passes if the toolchain alias targets can be analyzed.
build_test(
    name = "toolchain_resolves_test",
    targets = [
        "@flutter_toolchains//:darwin-arm64_toolchain",
        "@flutter_toolchains//:darwin-x64_toolchain",
        "@flutter_toolchains//:linux-x64_toolchain",
        "@flutter_toolchains//:linux-arm64_toolchain",
        "@flutter_toolchains//:windows-x64_toolchain",
    ],
)

# Negative: the sibling import is never declared, so the compile must fail.
# Manual so `//...` stays green; run explicitly to see the refusal.
consumer_caller(
    name = "consumer_negative",
    main = "consumer_undeclared_main.dart",
    tags = ["manual"],
)

# A root-registered custom release resolves exactly like a stock one. Only
# the Linux toolchain is checked: the engine revision is 3.47.7's, so every
# fetched byte is cache-shared with the stock toolchain above. The
# dart_sdk_files target forces the host repo fetch, so its engine artifacts
# are checksum-verified against the merged custom table.
build_test(
    name = "custom_toolchain_resolves_test",
    targets = [
        "@custom_toolchains//:linux-x64_toolchain",
        "@custom_linux-x64//:dart_sdk_files",
    ],
)

# Offline mode: the local toolchain resolves out of the checked-in fake_sdk
# tree with no network fetch. The dart_sdk_files target forces the host repo
# fetch, so the fake SDK's bin/cache layout is symlink-farmed for real.
build_test(
    name = "local_toolchain_resolves_test",
    targets = [
        "@local_toolchains//:linux-x64_toolchain",
        "@local_linux-x64//:dart_sdk_files",
    ],
)
