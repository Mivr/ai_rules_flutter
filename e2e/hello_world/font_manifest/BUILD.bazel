"""FontManifest diamond fixture (COV-63).

One font family reached along two dependency paths: the bundle config
must list the family once. `verify_font_manifest_unique_test` asserts
that over the real `flutter_assets/` tree.
"""

load("@rules_dart//dart:defs.bzl", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_asset_bundle", "flutter_library")

_HOST_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

flutter_library(
    name = "font_lib",
    srcs = ["lib.dart"],
    font_files = {
        ":fonts/Diamond.ttf": "fonts/Diamond.ttf",
    },
    fonts_json = '[{"family":"Diamond","fonts":[{"asset":"fonts/Diamond.ttf"}]}]',
)

flutter_library(
    name = "mid_left",
    srcs = ["lib.dart"],
    deps = [":font_lib"],
)

flutter_library(
    name = "mid_right",
    srcs = ["lib.dart"],
    deps = [":font_lib"],
)

flutter_asset_bundle(
    name = "diamond_bundle",
    deps = [
        ":mid_left",
        ":mid_right",
    ],
)

# A font family reached along two paths is written once in the bundle
# config. Reads `:diamond_bundle`'s `flutter_assets/` tree like
# `//:verify_pub_assets_test` does for pub assets.
dart_test(
    name = "verify_font_manifest_unique_test",
    data = [":diamond_bundle"],
    main = "verify_font_manifest_unique_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
