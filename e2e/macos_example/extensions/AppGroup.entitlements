<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Group the app and its extensions share.

  macOS takes two forms of group id: `<TEAM ID>.<name>`, which it grants to
  any bundle signed by that team without a profile, and `group.<name>`, the
  iOS form, which it grants only through a provisioning profile that lists
  it. This example is signed ad hoc, which has no team, and an ad hoc app
  launched from Finder or `open` is refused writes into its group container
  in either form: the container exists, files and preferences written to it
  do not persist. The bundle still builds, signs and registers its
  extensions the same way.

  The `group.` form is used because it carries no team id, so the example
  stays the same for everyone, and it matches iOS. An app signed with a team
  either lists the group in its profiles or uses its own team-prefixed form.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.flutterapp</string>
	</array>
</dict>
</plist>
