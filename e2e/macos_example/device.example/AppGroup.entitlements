<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The team-prefixed App Group for //:app_extensions_team. Replace TEAMID with
  your Team ID. macOS grants a group of this form to bundles signed by that
  team, so the team wildcard profile, which lists no groups, is enough.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>TEAMID.com.example.flutterapp</string>
	</array>
</dict>
</plist>
