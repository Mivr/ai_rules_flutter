load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_android//android:rules.bzl", "android_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_analysis_test", "dart_test")
load(
    "@rules_flutter//flutter:android.bzl",
    "flutter_android_app",
    "flutter_android_bundle",
    "flutter_android_engine",
    "flutter_android_manifest_gen",
    "flutter_android_runner_lib_gen",
)
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load("@rules_flutter//flutter:web.bzl", "flutter_web_bundle")
load("@rules_java//java:java_import.bzl", "java_import")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load(":apk_modes.bzl", "debug_build", "profile_build")

exports_files(["pubspec.lock"])

# =============================================================================
# Shared: Flutter application (Dart compilation)
# =============================================================================

# Native FFI library. flutter_android_bundle's platform transition compiles
# it with the Android NDK toolchain for the bundle's ABI.
cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    deps = [":add_cc"],
)

flutter_application(
    name = "app_flutter",
    package_name = "android_example",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    native_deps = [":add"],
    track_widget_creation = True,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_android_app)
#
# Recommended for most users. Requires android/app/src/main/ from
# `flutter create --platforms=android .`.
# The macro auto-discovers the manifest and resources from the conventional
# directory and wires everything automatically.
# =============================================================================

flutter_android_app(
    name = "app",
    package_name = "com.example.flutterapp",
    application = ":app_flutter",
    # `flutter create` grants INTERNET in the debug variant manifest only —
    # a *debugging* requirement for the Dart VM service, not the app's
    # network grant. A release APK built from the untouched scaffold cannot
    # open a socket at all (Android enforces INTERNET via AID_INET group
    # membership; every connect fails with EACCES, with no build error).
    # An app that networks declares it here, and gets it in every
    # compilation mode. Verified from inside the built APK by
    # :verify_android_permissions_test.
    permissions = ["android.permission.INTERNET"],
)

# =============================================================================
# Profile and widget-tracking proofs
#
# `:app_profile` is built behind `profile_build`, which sets `-c opt`, the
# `//flutter:profile` build setting and the arm64 Android platform. It shares
# `:app_flutter` and declares no `permissions`: the profile APK gets INTERNET
# from android/app/src/profile/AndroidManifest.xml, and `:app_release_check`
# built from the same main manifest does not. `:app_profile_apk` also forwards
# the pinned profile engine jar so the test can hash the `libflutter.so` the
# APK packages.
#
# `:app_flutter` sets `track_widget_creation = True` explicitly; the twin
# `:app_flutter_untracked` has the same sources and deps with the flag off.
# The debug APK twins let the test read each compiled kernel.
# =============================================================================

flutter_android_app(
    name = "app_profile",
    package_name = "com.example.flutterapp.profile",
    application = ":app_flutter",
)

flutter_android_app(
    name = "app_release_check",
    package_name = "com.example.flutterapp.releasecheck",
    application = ":app_flutter",
)

profile_build(
    name = "app_profile_apk",
    testonly = True,
    targets = [
        ":app_profile",
        "@flutter_android_engine_arm64_profile//:stripped",
    ],
)

flutter_application(
    name = "app_flutter_untracked",
    package_name = "android_example",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    native_deps = [":add"],
    track_widget_creation = False,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_android_app(
    name = "app_untracked",
    package_name = "com.example.flutterapp.untracked",
    application = ":app_flutter_untracked",
)

debug_build(
    name = "app_debug_apk",
    testonly = True,
    targets = [":app"],
)

debug_build(
    name = "app_untracked_debug_apk",
    testonly = True,
    targets = [":app_untracked"],
)

# =============================================================================
# Shared Android targets (used by approaches 2 & 3)
# =============================================================================

flutter_android_bundle(
    name = "app_android",
    application = ":app_flutter",
)

# Extract native_libs.jar for composable wiring.
filegroup(
    name = "app_native_libs_jar",
    srcs = [":app_android"],
    output_group = "native_libs_jar",
    tags = ["manual"],
)

java_import(
    name = "app_native_libs",
    jars = [":app_native_libs_jar"],
    tags = ["manual"],
)

flutter_android_engine(
    name = "app_engine",
)

# Extract flutter_assets for composable approaches.
filegroup(
    name = "app_flutter_assets",
    srcs = [":app_android"],
    output_group = "mobile_install",
    tags = ["manual"],
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_android_runner_lib_gen)
#
# For users without `flutter create` output. Uses template manifest and
# Kotlin MainActivity from rules_flutter. Only needs package_name.
# =============================================================================

flutter_android_manifest_gen(
    name = "bazel_runner_manifest",
    package_name = "com.example.flutterapp.bazelrunner",
    app_name = "Flutter App (Bazel Runner)",
)

flutter_android_runner_lib_gen(
    name = "bazel_runner_lib",
    package_name = "com.example.flutterapp.bazelrunner",
    engine = ":app_engine",
)

android_binary(
    name = "app_bazel_runner",
    assets = [":app_flutter_assets"],
    assets_dir = "assets",
    custom_package = "com.example.flutterapp.bazelrunner",
    manifest = ":bazel_runner_manifest",
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":app_native_libs",
        ":bazel_runner_lib",
    ],
)

# =============================================================================
# Approach 3: Custom runner (manual wiring with Kotlin)
#
# For advanced users who want full control. User provides their own
# AndroidManifest.xml and custom Kotlin Activity, compiled via
# kt_android_library with flutter_android_bundle + flutter_android_engine.
# =============================================================================

kt_android_library(
    name = "custom_runner_lib",
    srcs = ["custom_runner/MainActivity.kt"],
    custom_package = "com.example.flutterapp.customrunner",
    manifest = "custom_runner/AndroidManifest.xml",
    tags = ["manual"],
    deps = [
        ":app_engine",
        "@rules_android_maven//:androidx_annotation_annotation",
        "@rules_android_maven//:androidx_lifecycle_lifecycle_common",
    ],
)

android_binary(
    name = "app_custom_runner",
    assets = [":app_flutter_assets"],
    assets_dir = "assets",
    custom_package = "com.example.flutterapp.customrunner",
    manifest = "custom_runner/AndroidManifest.xml",
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":app_native_libs",
        ":custom_runner_lib",
    ],
)

# =============================================================================
# Web build — same Dart code, no native deps.
# =============================================================================

flutter_web_bundle(
    name = "app_web",
    package_name = "android_example",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    deps = ["@deps//:flutter"],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "android_app_build_test",
    targets = [":app"],
)

build_test(
    name = "android_bazel_runner_build_test",
    targets = [":app_bazel_runner"],
)

build_test(
    name = "android_custom_runner_build_test",
    targets = [":app_custom_runner"],
)

build_test(
    name = "web_build_test",
    targets = [":app_web"],
)

dart_test(
    name = "verify_android_apk_test",
    data = [":app"],
    main = "test/verify_android_apk_test.dart",
)

# Reads the permissions out of the compiled binary AndroidManifest.xml inside
# the built APK. Bazel's default fastbuild is not `-c dbg`, so this APK takes
# the non-debug manifest arm — finding INTERNET proves it came from
# flutter_android_app(permissions = ...) rather than from flutter create's
# debug variant overlay.
dart_test(
    name = "verify_android_permissions_test",
    srcs = ["test/axml.dart"],
    data = [":app"],
    main = "test/verify_android_permissions_test.dart",
)

# The profile APK, the pinned profile and release engine jars, and the release
# twin built from the same main manifest: the APK's libflutter.so must be the
# pinned profile engine and differ from the release engine, its libapp.so must
# be an aarch64 AOT ELF without the `product` feature, and INTERNET must come
# from the profile variant manifest while the release APK omits it.
dart_test(
    name = "verify_android_profile_apk_test",
    srcs = [
        "test/android_test_support.dart",
        "test/axml.dart",
    ],
    data = [
        ":app_profile_apk",
        ":app_release_check",
        "@flutter_android_engine_arm64//:stripped",
    ],
    main = "test/verify_android_profile_apk_test.dart",
)

# The debug APK twins: the tracking-on kernel carries the pinned SDK's
# widget-creation marker, the tracking-off kernel does not.
dart_test(
    name = "verify_android_widget_tracking_test",
    srcs = ["test/android_test_support.dart"],
    data = [
        ":app_debug_apk",
        ":app_untracked_debug_apk",
    ],
    main = "test/verify_android_widget_tracking_test.dart",
)

dart_test(
    name = "verify_android_app_test",
    data = [":app"],
    main = "test/verify_android_app_test.dart",
    tags = [
        "exclusive",
        "manual",
    ],
)

# `manual`, so `bazel test //...` never gives it to the analysis aspect; this
# checks it anyway.
dart_analysis_test(
    name = "verify_android_app_test_analysis",
    targets = [":verify_android_app_test"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    package_name = "android_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
    ],
)
