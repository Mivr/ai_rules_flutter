"E2e test: Flutter web integration test (flutter_integration_test)"

module(name = "rules_flutter_integration_web")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.7.3")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

git_override(
    module_name = "rules_dart",
    commit = "3aed63a6a38909d47486411d8b2f732d6791d5be",
    remote = "https://github.com/Mivr/rules_dart.git",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.7")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "deps", "flutter_toolchains", "flutter_web_sdk")

register_toolchains("@flutter_toolchains//:all")
