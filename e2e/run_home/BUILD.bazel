load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_integration_test", "flutter_prebuilt_test", "flutter_test")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")

exports_files(["pubspec.lock"])

# run_home: run-HOME hermeticity gate workspace. Every `bazel run`-capable
# entry point the rules ship (or generate) gets one instance here so
# run_home_test.sh can execute it under canary HOME dirs and prove neither
# the tool CLIs (dart, flutter_tools, pub) nor the rule-owned launchers
# write telemetry or state into the caller's home directory.

_HOST_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

flutter_test(
    name = "widget_test",
    package_name = "run_home",
    srcs = ["lib/main.dart"],
    main = "test/widget_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

filegroup(
    name = "widget_test_kernel",
    testonly = True,
    srcs = [":widget_test"],
    output_group = "test_kernel",
)

filegroup(
    name = "widget_test_base_kernel",
    testonly = True,
    srcs = [":widget_test"],
    output_group = "test_base_kernel",
)

filegroup(
    name = "widget_test_assets",
    testonly = True,
    srcs = [":widget_test"],
    output_group = "test_assets",
)

flutter_prebuilt_test(
    name = "widget_prebuilt_test",
    assets = ":widget_test_assets",
    base_dill = [":widget_test_base_kernel"],
    dill = ":widget_test_kernel",
    target_compatible_with = _HOST_COMPATIBLE,
)

flutter_integration_test(
    name = "app_test_linux",
    package_name = "run_home",
    srcs = ["integration_test/app_test.dart"],
    app_srcs = ["lib/main.dart"],
    platform = "linux",
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_integration_test(
    name = "app_test_web",
    package_name = "run_home",
    srcs = ["integration_test/app_test.dart"],
    app_srcs = ["lib/main.dart"],
    platform = "web",
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_application(
    name = "run_home_app",
    package_name = "run_home",
    main = "lib/main.dart",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_linux_app(
    name = "run_home_linux",
    application = ":run_home_app",
    gtk_app_id = "com.example.runhome",
    target_compatible_with = ["@platforms//os:linux"],
)

flutter_web_app(
    name = "run_home_web",
    package_name = "run_home",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
