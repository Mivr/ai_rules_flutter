"e2e: minimum supported rules_apple/rules_android floors"

module(name = "rules_flutter_min_versions")

bazel_dep(name = "ai_rules_flutter", version = "0.0.0", repo_name = "rules_flutter")
bazel_dep(name = "ai_rules_dart", version = "0.21.0", repo_name = "rules_dart")
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# Every regular dependency is declared at the floor rules_flutter supports,
# never at the release this repository compiles. The comments in the root
# MODULE.bazel name the symbol that sets each floor; this workspace is the
# proof that the set builds together. Some of these floors are lifted by
# another module's own requirement (ai_rules_dart 0.21.0 asks for newer
# rules_cc, bazel_skylib, package_metadata and rules_go; rules_android 0.8.0
# asks for newer rules_java and rules_jvm_external, and the newer rules_cc
# asks for newer apple_support). Those modules stay at the floor here and MVS
# selects the lift, which `//:dependency_floors_test` asserts and attributes;
# pinning them down with an override would hide the graph a consumer gets.
bazel_dep(name = "bazel_skylib", version = "1.8.0")
bazel_dep(name = "package_metadata", version = "0.0.5")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_swift", version = "3.5.0")
bazel_dep(name = "rules_kotlin", version = "2.1.10")
bazel_dep(name = "rules_java", version = "9.0.0")
bazel_dep(name = "rules_jvm_external", version = "6.8")

local_path_override(
    module_name = "ai_rules_flutter",
    path = "../..",
)

git_override(
    module_name = "ai_rules_dart",
    commit = "4cc0c0ab2ed8256bec5a1503cc2ab22e1bfe9875",
    remote = "https://github.com/Mivr/rules_dart.git",
)

# Hermetic host C++ toolchain: CI images and bare hosts may have no
# gcc/ar, and the local cc_configure detection fails without them (same
# block as e2e/integration_android). llvm's floor is 0.8.17 (the xtool SDK
# and the prebuilt-toolchain repos this workspace registers); llvm itself
# asks for rules_cc 0.2.22, bazel_skylib 1.9.0 and rules_go 0.62.0, which
# ai_rules_dart 0.21.0 lifts further.
bazel_dep(name = "llvm", version = "0.8.17", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:linux_aarch64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_x86_64",
    "@llvm//toolchain:linux_x86_64_to_linux_aarch64",
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
    "@llvm//toolchain:macos_aarch64_to_linux_aarch64",
    "@llvm//toolchain:macos_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_x86_64_to_linux_aarch64",
    "@llvm//toolchain:macos_x86_64_to_linux_x86_64",
    dev_dependency = True,
)

# The floors that can bind are pinned exactly: a root `single_version_override`
# makes MVS ignore any other requester, so this workspace keeps testing the
# release rules_flutter promises instead of floating with the graph. The
# Apple pair is the proven floor from the original workspace; rules_kotlin,
# llvm, rules_android and platforms are the remaining floors no other module
# asks to raise.
#
# The lifted floors are deliberately NOT overridden here: ai_rules_dart 0.21.0
# asks for newer rules_cc, bazel_skylib, package_metadata and rules_go;
# rules_android 0.8.0 asks for rules_java 9.3.0 and rules_jvm_external 6.9;
# rules_cc 0.2.26 asks for apple_support 2.9.1. Forcing those below their
# requester's floor would build a graph no consumer can get (and would hide a
# real requirement), so they stay declared at the floor and
# `//:dependency_floors_test` asserts the lifted value and its source. The
# root `single_version_override`s keep rules_flutter's own CI on current
# releases; consumers ignore both sets.
single_version_override(
    module_name = "platforms",
    version = "1.1.0",
)

single_version_override(
    module_name = "rules_apple",
    version = "4.5.3",
)

single_version_override(
    module_name = "rules_swift",
    version = "3.5.0",
)

single_version_override(
    module_name = "rules_android",
    version = "0.8.0",
)

single_version_override(
    module_name = "rules_kotlin",
    version = "2.1.10",
)

single_version_override(
    module_name = "llvm",
    version = "0.8.17",
)

# The resolved-version proof: a repository rule reads each selected module's
# own `MODULE.bazel` (and the root pin for the git-overridden rules_dart), so
# `//:dependency_floors_test` asserts the graph Bazel actually built instead
# of a checked-in model of it.
resolved_module_versions = use_repo_rule("//:resolved_module_versions.bzl", "resolved_module_versions")

resolved_module_versions(
    name = "resolved_module_versions",
    floors = "@rules_flutter//flutter/tests:dependency_floors.json",
)

# Pinned past the 0.1.5 release for 16KB page alignment (same as
# e2e/integration_android).
archive_override(
    module_name = "rules_android_ndk",
    sha256 = "0f566314be1257379d42630e068618169e410e4ecf964b28e0c72559e2196658",
    strip_prefix = "rules_android_ndk-987213e7f982de48696f3b9cd031ff4e3e065c7c",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/archive/987213e7f982de48696f3b9cd031ff4e3e065c7c.tar.gz"],
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.7")

# Minimal lock: only the `flutter` SDK dependency and its hosted transitive
# closure (characters, collection, material_color_utilities, meta,
# vector_math). Regenerated with the pinned toolchain's own Dart SDK plus a
# FLUTTER_ROOT assembled from the framework packages the toolchain already
# materializes (packages/flutter, packages/sky_engine) and
# bin/cache/flutter.version.json stamped 3.47.7/Dart 3.13.5:
#   FLUTTER_ROOT=<root> PUB_CACHE=<scratch> dart pub get
# then copied here. Every hosted entry carries a sha256; the two `sdk`
# entries resolve against the pinned toolchain, not the network. The lock
# records no `flutter:` sdk floor (only `flutter pub` writes one), so the
# extension's newer-resolver check is skipped — the build against 3.47.7
# itself is the proof.
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(
    flutter,
    "deps",
    "flutter_android_engine_arm64",
    "flutter_ios_engine",
    "flutter_macos_engine",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# Override rules_android's Go SDK with sha256-pinned 1.26.2 archives. rules_go
# declares only the 0.59.0 minimum here (same as rules_flutter's own
# MODULE.bazel) — MVS still selects 0.64.2 through rules_dart, so the proxy's
# pure-Go transition is proven against the resolved version, never the floor.
bazel_dep(name = "rules_go", version = "0.59.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    sdks = {
        "darwin_amd64": ("go1.26.2.darwin-amd64.tar.gz", "bc3f1500d9968c36d705442d90ba91addf9271665033748b82532682e90a7966"),
        "darwin_arm64": ("go1.26.2.darwin-arm64.tar.gz", "32af1522bf3e3ff3975864780a429cc0b41d190ec7bf90faa661d6d64566e7af"),
        "linux_amd64": ("go1.26.2.linux-amd64.tar.gz", "990e6b4bbba816dc3ee129eaeaf4b42f17c2800b88a2166c265ac1a200262282"),
        "linux_arm64": ("go1.26.2.linux-arm64.tar.gz", "c958a1fe1b361391db163a485e21f5f228142d6f8b584f6bef89b26f66dc5b23"),
    },
    version = "1.26.2",
)

# rules_android: download android build tools and discover local SDK.
#
# Host prerequisites for the Android leg: rules_android's AAR extractors run
# `unzip` (shell) and `python3` (shebang) from the action environment, which
# under Bazel's default strict action env carries neither a PATH nor the
# client's tools — both must exist in the default lookup locations
# (/usr/bin on stock CI images; GitHub's ubuntu-latest and macos-latest
# qualify). A host without them fails every aar_import at execution, and the
# shell extractor's missing-file fallback can additionally leave an empty
# manifest behind, so a later stage fails instead. Analysis and the Dart leg
# need neither.
remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(api_level = 35)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains(
    "@androidsdk//:sdk-toolchain",
    "@androidsdk//:all",
)

# Android NDK: provides the CC toolchain for Android-configured actions
# (the engine strip runs under the Android platform). Same as
# e2e/integration_android.
android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")

# Fix protobuf version mismatch: rules_android pins protobuf-java 4.33.4
# but the resolved protobuf module is 34.0 (gencode 4.34.0).  The root module's
# maven.install tags take precedence, so we re-declare the two affected repos
# with bumped protobuf jars. rules_jvm_external itself is already declared at
# its 6.8 floor above; a second bazel_dep would be a duplicate repo name.

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "android_ide_common_30_1_3",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "com.android.tools.layoutlib:layoutlib-api:30.1.3",
        "com.android.tools.build:manifest-merger:30.1.3",
        "com.android.tools:common:30.1.3",
        "com.android.tools:repository:30.1.3",
        "com.android.tools.analytics-library:protos:30.1.3",
        "com.android.tools.analytics-library:shared:30.1.3",
        "com.android.tools.analytics-library:tracker:30.1.3",
        "com.android.tools:annotations:30.1.3",
        "com.android.tools:sdk-common:30.1.3",
        "com.android.tools.build:builder:7.1.3",
        "com.android.tools.build:builder-model:7.1.3",
        "com.google.protobuf:protobuf-java:4.34.0",
        "com.google.protobuf:protobuf-java-util:4.34.0",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        # The Flutter engine's androidx runtime artifacts, plus everything
