load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_analysis_test", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_gen_l10n", "flutter_integration_test", "flutter_test")
load("@rules_flutter//flutter:ios.bzl", "flutter_ios_registrant_gen", "flutter_ios_simulator_build_test")

exports_files(["pubspec.lock"])

# The generated localizations `:app_test` compiles into the app and renders
# under `Locale('es')`, so an iOS-only regression in gen-l10n output or in the
# `output_class` / `nullable_getter` options fails the simulator run.
flutter_gen_l10n(
    name = "app_l10n",
    arbs = [
        "lib/l10n/app_en.arb",
        "lib/l10n/app_es.arb",
    ],
    nullable_getter = False,
    output_class = "Cov79Localizations",
)

flutter_integration_test(
    name = "app_test",
    package_name = "integration_ios",
    srcs = [
        "integration_test/app_test.dart",
        ":app_l10n",
    ],
    app_srcs = ["lib/main.dart"],
    assets = ["assets/logo.png"],
    defines = ["COV79_GREETING=hello, world=ok"],
    platform = "ios",
    shaders = ["shaders/ink_stub.frag"],
    deps = [
        "//android_only_plugin",
        "//dart_registration_plugin",
        "//ffi_plugin",
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_localizations",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:intl",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The generated iOS native registrant for the app above, consumed on Linux by
# `:plugin_registrant_filter_test`. It is also what the app itself generates
# internally; naming it here makes the filtering assertion a portable test
# instead of an Xcode-only one.
flutter_ios_registrant_gen(
    name = "app_test_registrant",
    application = ":__app_test_app",
)

# Linux-runnable: the registrant has no import or registration call for the
# Android-only plugin, while still registering the app's iOS plugin. A
# filtering regression fails here before the macOS simulator leg.
dart_test(
    name = "plugin_registrant_filter_test",
    args = ["$(rlocationpaths :app_test_registrant)"],
    data = [":app_test_registrant"],
    main = "test/plugin_registrant_filter_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The SwiftPM plugin suite: proves a pub path plugin's `Package.swift`
# product (BigInt, from the hub's pinned `<hub>__swiftpm-bigint` spoke)
# links into the plugin's Apple library. The native method computes
# 2^100 with BigInt at run time, so the assertion below only passes
# when the product made it into the link.
flutter_integration_test(
    name = "plugin_spm_test",
    package_name = "integration_ios",
    srcs = ["integration_test/plugin_spm_test.dart"],
    app_srcs = ["lib/main.dart"],
    assets = ["assets/logo.png"],
    platform = "ios",
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:spm_bigint_plugin",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The transitive SwiftPM graph suite: proves a pub path plugin's
# `Package.swift` products (swift-algorithms' Algorithms plus
# swift-numerics' RealModule, down through its C `_NumericsShims`, from the
# hub's pinned spokes) link into the plugin's Apple library. The native
# method counts 2-combinations with Algorithms and evaluates `e` with
# RealModule at run time, so the assertion below only passes when the whole
# graph made it into the link.
flutter_integration_test(
    name = "plugin_spm_graph_test",
    package_name = "integration_ios",
    srcs = ["integration_test/plugin_spm_graph_test.dart"],
    app_srcs = ["lib/main.dart"],
    assets = ["assets/logo.png"],
    platform = "ios",
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:spm_graph_plugin",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Red twin of `:app_test`: its expectation is wrong on purpose (see
# integration_test/red_test.dart). `manual` so `bazel test //...` stays green;
# the full-matrix workflow runs it by name and asserts the run FAILS, proving
# the simulator harness reports assertion failures loudly.
flutter_integration_test(
    name = "app_test_red",
    package_name = "integration_ios",
    srcs = ["integration_test/red_test.dart"],
    app_srcs = ["lib/main.dart"],
    assets = ["assets/logo.png"],
    platform = "ios",
    tags = ["manual"],
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Linux-runnable proof that the workspace loads and its Dart side compiles:
# the bootstrap and the kernel application are portable, while the
# Apple-toolchain targets (and the test targets above) skip off macOS via
# `target_compatible_with`. `bazel test //...` runs this on every OS.
build_test(
    name = "ios_dart_side_build_test",
    targets = [
        ":__app_test_bootstrap",
        ":__app_test_app",
        ":__plugin_spm_test_bootstrap",
        ":__plugin_spm_test_app",
        ":__plugin_spm_graph_test_bootstrap",
        ":__plugin_spm_graph_test_app",
    ],
)

# Host-side lint fixtures for the macOS-only suites: a `flutter_test` owns
# `srcs` (its package's `lib/`) plus one `main` outside it — exactly the
# lib/main.dart + integration_test/*.dart split the simulator suites compile.
# Tagged `manual` and never run: `bazel test //...` skips them and nothing
# names them, because on a host the plugin channel has no native side and the
# asset bundle is absent, so they would fail. They exist so the Linux analysis
# test below lints the macOS-only Dart on every OS. Like the suites, they must
# not depend on the macOS-only app.
flutter_test(
    name = "app_test_lint",
    package_name = "integration_ios",
    srcs = [
        "lib/main.dart",
        ":app_l10n",
    ],
    main = "integration_test/app_test.dart",
    tags = ["manual"],
    deps = [
        "//android_only_plugin",
        "//dart_registration_plugin",
        "//ffi_plugin",
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_localizations",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:intl",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_test(
    name = "app_test_red_lint",
    package_name = "integration_ios",
    srcs = ["lib/main.dart"],
    main = "integration_test/red_test.dart",
    tags = ["manual"],
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Host-side lint twin of `:plugin_spm_test`: same portable split (the
# app's `lib/main.dart` plus the test file as `main`) so the analysis
# test below lints the SwiftPM plugin's Dart on every OS.
flutter_test(
    name = "plugin_spm_test_lint",
    package_name = "integration_ios",
    srcs = ["lib/main.dart"],
    main = "integration_test/plugin_spm_test.dart",
    tags = ["manual"],
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:spm_bigint_plugin",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The macOS-only Dart (lib/, integration_test/) cannot be named by
# `bazel test //...` on Linux: the app, debug-app and test targets skip off
# macOS via `target_compatible_with`, so the `.bazelrc` analysis aspect never
# reaches them there. The lint fixtures above are portable and carry the same
# sources, so this lints them on every OS; the plugin's own library target
# covers its lib/.
# Host-side lint twin of `:plugin_spm_graph_test`: same portable split so
# the analysis test below lints the transitive-graph plugin's Dart on
# every OS.
flutter_test(
    name = "plugin_spm_graph_test_lint",
    package_name = "integration_ios",
    srcs = ["lib/main.dart"],
    main = "integration_test/plugin_spm_graph_test.dart",
    tags = ["manual"],
    deps = [
        "//ios_greeting_plugin",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:spm_graph_plugin",
        "@rules_flutter//flutter:material_icons",
    ],
)

dart_analysis_test(
    name = "ios_dart_analysis_test",
    targets = [
        ":app_test_lint",
        ":app_test_red_lint",
        ":plugin_registrant_filter_test",
        ":plugin_spm_test_lint",
        ":plugin_spm_graph_test_lint",
        "//android_only_plugin",
        "//dart_registration_plugin",
        "//ffi_plugin",
        "//ios_greeting_plugin",
    ],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# The SwiftPM consumer app: a bare `ios_application` embedding the
# `//swiftpm_consumer` module (which imports the translated BigInt product),
# so the simulator build test below compiles BigInt for the iOS simulator.
# It is never launched; the build is the test. It carries no OS constraint
# (the simulator platform's OS is ios, not macos); `manual` keeps Linux's
# `bazel test //...` from building it on the host, and only the build test
# below carries the macOS constraint (it runs on a macOS host).
ios_application(
    name = "swiftpm_consumer_app",
    bundle_id = "com.example.integrationios.swiftpmconsumer",
    families = ["iphone"],
    infoplists = ["//swiftpm_consumer:Info.plist"],
    minimum_os_version = "15.0",
    tags = ["manual"],
    deps = ["//swiftpm_consumer"],
)

# macOS-only: needs Xcode and the iOS SDK. `bazel test //...` skips it off
# macOS via `target_compatible_with`; the integration_ios leg runs it on the
# macOS runner, building the `Package.resolved` BigInt pin for the
# simulator. Only this test (which runs on the macOS host) carries the macOS
# constraint; the app and library it builds carry none.
flutter_ios_simulator_build_test(
    name = "swiftpm_consumer_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":swiftpm_consumer_app"],
)
