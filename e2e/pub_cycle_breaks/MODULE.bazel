"""Cycle-break proof: one lock, two hubs, and a raw repository cycle.

`cycle_a` and `cycle_b` are workspace-relative path packages that each
declare the other, exactly the shape a lock takes when pub resolves two
packages against each other through conditional imports. `cycle_app` depends
on both, so both spokes are reachable from an app target.

`deps` breaks only `cycle_a`'s edge to `cycle_b`; `deps_cycle` is the same
lock with no `cycle_breaks`. The full-matrix workflow queries
`@deps__cycle_a//:all` and requires it to resolve, then queries the twin
`@deps_cycle__cycle_a//:all` and requires the repository-cycle failure.
"""

module(name = "rules_flutter_pub_cycle_breaks")

bazel_dep(name = "ai_rules_flutter", version = "0.0.0", repo_name = "rules_flutter")
bazel_dep(name = "ai_rules_dart", version = "0.21.0", repo_name = "rules_dart")

local_path_override(
    module_name = "ai_rules_flutter",
    path = "../..",
)

git_override(
    module_name = "ai_rules_dart",
    commit = "4cc0c0ab2ed8256bec5a1503cc2ab22e1bfe9875",
    remote = "https://github.com/Mivr/ai_rules_dart.git",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.7")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
    cycle_breaks = {"cycle_a": ["cycle_b"]},
)
flutter.pub(
    name = "deps_cycle",
    lock = "//:pubspec.lock",
)
use_repo(
    flutter,
    "deps",
    "deps__cycle_a",
    "deps__cycle_app",
    "deps__cycle_b",
    "deps_cycle",
    "deps_cycle__cycle_a",
    "deps_cycle__cycle_app",
    "deps_cycle__cycle_b",
)
